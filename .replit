modules = ["nodejs-20", "web", "bash", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000


[nix]
channel = "stable-25_05"

[userenv.shared]
NODE_ENV = "development"
SMTP_FROM_EMAIL = "admin@myifa.co.za"
SMTP_FROM_NAME = "MyIFA"
SMTP_HOST = "smtp.myifa.co.za"
SMTP_PORT = "465"
SMTP_USER = "admin@myifa.co.za"

[[ports]]
localPort = 25580
externalPort = 3002

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MyIFA portal preview"

[[workflows.workflow]]
name = "MyIFA portal preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd opian-guide && PORT=5000 pnpm --filter @workspace/opian-portal run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
