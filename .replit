modules = ["nodejs-24"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Opian portal preview"

[[workflows.workflow]]
name = "Opian portal preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd opian-guide && PORT=5000 pnpm --filter @workspace/opian-portal run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 22729
externalPort = 3001

[[ports]]
localPort = 25580
externalPort = 3002
